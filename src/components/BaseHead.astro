---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { ADSENSE, SITE, SOCIAL } from '../data/site';
import { getSocialImageUrl } from '../lib/social-image';
import defaultImage from '../assets/images/social-default.webp';

export interface Props {
  /** Page title; the site name is appended automatically. Omit on the home page. */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = defaultImage,
  imageAlt = 'Jonathas Costa, Software Crafter: blueprint diagram of a .NET 8 API with SQL Server, Cosmos DB, AWS Lambda, GitHub Actions and Grafana',
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const documentTitle = title ? `${title} · ${SITE.name}` : SITE.title;
// With build.format 'file' the home page path is /index.html; its canonical URL is /.
const canonical = new URL(Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1'), Astro.site);

const socialImageUrl = await getSocialImageUrl(image, Astro.site!);

// Escape "<" so structured data can never close the surrounding <script>.
const structuredData = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{documentTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="author" content={SITE.author} />

<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
<!-- Apply a saved theme before the first paint to avoid a flash of the wrong colours. -->
<script is:inline>
  try {
    const theme = localStorage.getItem('theme');
    if (theme === 'light' || theme === 'dark') {
      document.documentElement.dataset.theme = theme;
      for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
        meta.setAttribute('content', theme === 'dark' ? '#0f0f0e' : '#faf9f6');
      }
    }
  } catch {}
</script>

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Articles`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-instrument-serif" preload={[{ style: 'normal' }]} />
<Font cssVariable="--font-jetbrains-mono" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={SOCIAL.linkedin} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}

<!-- Google AdSense. If an ad blocker stops the script, the ad slots collapse (see .ads-blocked). -->
<meta name="google-adsense-account" content={ADSENSE.client} />
<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE.client}`}
  crossorigin="anonymous"
  onerror="document.documentElement.classList.add('ads-blocked')"></script>
