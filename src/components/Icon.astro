const { name, size = 20, label, class: className } = Astro.props;
const icon: { body: string; stroke?: boolean; viewBox?: string } = icons[name];
---

<svg
  class:list={['icon', `icon-${name}`, className]}
  width={size}
  height={size}
  viewBox={icon.viewBox ?? '0 0 24 24'}
  fill={icon.stroke ? 'none' : 'currentColor'}
  stroke={icon.stroke ? 'currentColor' : undefined}
  stroke-width={icon.stroke ? 2 : undefined}
  stroke-linecap={icon.stroke ? 'round' : undefined}
  stroke-linejoin={icon.stroke ? 'round' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>
