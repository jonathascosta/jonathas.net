---
import { getImage } from 'astro:assets';
import { experience, industries, type IndustryKey } from '../data/experience';

// The Flaticon line icons are black on transparent. Used as CSS masks they take the
// current text colour, so they work in both light and dark themes.
const iconUrls = Object.fromEntries(
  await Promise.all(
    Object.entries(industries).map(async ([key, { icon }]) => {
      const { src } = await getImage({ src: icon, width: 96, height: 96, format: 'webp', layout: 'none' });
      return [key, src] as const;
    }),
  ),
) as Record<IndustryKey, string>;
---

<ol class="journey" role="list">
  {
    experience.map((item) => (
      <li class="entry">
        <p class="period">{item.period}</p>
        <div class="content">
          <h3 class="heading">
            <span class="company">{item.company}</span>
            <span class="sr-only">, </span>
            <span class="role">{item.role}</span>
          </h3>
          <ul class="industries" role="list">
            {item.industries.map((key) => (
              <li>
                <span class="industry-icon" style={`--icon: url("${iconUrls[key]}")`} aria-hidden="true" />
                {industries[key].label}
              </li>
            ))}
          </ul>
          <p class="summary">{item.summary}</p>
          <ul class="tags" role="list">
            {item.stack.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .journey {
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .entry {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--border);
  }

  .period {
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-subtle);
    white-space: nowrap;
  }

  .content {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .heading {
    display: grid;
    gap: 0.2rem;
  }

  .company {
    font-size: 1.375rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .role {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 400;
    color: var(--text-muted);
  }

  .industries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .industries li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .industry-icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--accent);
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }

  .summary {
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: 1fr;
    }

    .period {
      padding-top: 0;
    }
  }
</style>
