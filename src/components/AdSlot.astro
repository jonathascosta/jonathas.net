---
// Filled by src/scripts/ads.ts. The Markdown plugin src/lib/rehype-in-article-ad.ts writes the same markup.
interface Props {
  /** AdSense ad unit id. */
  slot: string;
  class?: string;
}

const { slot, class: className } = Astro.props;
---

<div class:list={['ad', className]} data-slot={slot}>
  <p class="ad-label">Advertisement</p>
</div>
